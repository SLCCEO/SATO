[Unit]
Description=SATO Sovereign Comm-Net Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=satobot
WorkingDirectory=/opt/sato-bot
ExecStart=/usr/bin/python3 /opt/sato-bot/bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
